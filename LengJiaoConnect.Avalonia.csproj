<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LengJiaoConnect</AssemblyName>
    <RootNamespace>LengJiaoConnect</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>3.2.0</Version>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- 仓库根下的旧式嵌套克隆不参与编译 -->
    <Compile Remove="LengJiaoConnect\**" />
    <AvaloniaXaml Remove="LengJiaoConnect\**" />
    <Page Remove="LengJiaoConnect\**" />
    <EmbeddedResource Remove="LengJiaoConnect\**" />
    <None Remove="LengJiaoConnect\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="SukiUI" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <None Include="HelperApk\LengJiaoHelper.apk" CopyToOutputDirectory="PreserveNewest" />
    <None Include="HelperApk\AndroidManifest.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Tools\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
